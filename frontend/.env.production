# Production build (vite build) talks to the Express API on Render.
#
# `npm run dev` uses mode=development instead, so it still goes through the Vite
# proxy to http://localhost:5000 — the local backend keeps working unchanged.
#
# If you ever deploy the SPA with the API on the same origin again (the Netlify
# function, or Render serving frontend/dist), delete this file or empty the value.
VITE_API_BASE_URL=https://meditrack-1owj.onrender.com
