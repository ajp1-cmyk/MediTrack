# Where the MediTrack API lives.
#
# Leave it empty when the SPA and the API share an origin:
#   • local development — the Vite proxy (vite.config.js) forwards /api and
#     /uploads to http://localhost:5000
#   • a deploy where one host serves both (Netlify function, Render web service)
#
# Set it when the API is on another origin, e.g. an SPA on Netlify with the
# Express server on Render:
#
#   VITE_API_BASE_URL=https://meditrack-1owj.onrender.com
#
# Vite inlines this at build time, so rebuild (or redeploy on Netlify) after
# changing it. Cross-origin use also requires, on the API:
#   CORS_ORIGIN=https://<the-spa-origin>        (allow the browser origin)
#   COOKIE_SAMESITE=none                        (HTTPS only; keeps cookies working)
VITE_API_BASE_URL=
