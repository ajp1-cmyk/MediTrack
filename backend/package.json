{
  "name": "meditrack-backend",
  "version": "1.0.0",
  "description": "MediTrack backend - Express + MongoDB (Mongoose) with JWT authentication",
  "main": "server.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "db:check": "node scripts/check-db.js",
    "db:local": "node scripts/local-mongo.js",
    "seed:admin": "node scripts/seed-admin.js",
    "seed:demo": "node scripts/seed-demo.js",
    "seed:data": "node scripts/data.js",
    "migrate:roles": "node scripts/migrate-roles.js",
    "inventory:replenish": "node scripts/replenish-inventory.js",
    "smoke:deploy": "node scripts/smoke-deploy.js",
    "test": "node --test"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.5",
    "@netlify/blobs": "^11.1.7",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^7.8.12",
    "multer": "^2.0.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.2.0"
  }
}
