# Copy this file to .env and adjust the values.

# Express port
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB connection string — local MongoDB or cloud MongoDB (MongoDB Atlas).
# The application code is identical for both; only this value changes.
#
# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/meditrack
#
# MongoDB Atlas (cloud):  Atlas → Database → Connect → Drivers → copy the string
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meditrack?retryWrites=true&w=majority
#
# Atlas checklist:
#   1. Database Access  → create a database user (remember user + password)
#   2. Network Access   → add your IP address (or 0.0.0.0/0 while developing)
#   3. Put the database name in the path (…mongodb.net/meditrack?retryWrites=…)
#      otherwise the app writes into the default "test" database
#   4. URL-encode special characters in the password:
#      @ → %40   # → %23   / → %2F   : → %3A   ? → %3F   % → %25
#   5. Check it before starting the backend:  npm run db:check
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/meditrack

# Secret used to sign JWTs. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login token stays valid (7d, 12h, 30m, ...)
JWT_EXPIRES_IN=7d
