# Copy this file to .env and adjust the values.

# Express port
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB connection string — local MongoDB or cloud MongoDB (MongoDB Atlas).
# The application code is identical for both; only this value changes.
#
# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/meditrack
#
# MongoDB Atlas (cloud):  Atlas → Database → Connect → Drivers → copy the string
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meditrack?retryWrites=true&w=majority
#
# Atlas checklist:
#   1. Database Access  → create a database user (remember user + password)
#   2. Network Access   → add your IP address (or 0.0.0.0/0 while developing)
#   3. Put the database name in the path (…mongodb.net/meditrack?retryWrites=…).
#      If the path is omitted the app falls back to MONGODB_DB (default
#      "meditrack") instead of writing into MongoDB's default "test" database.
#   4. URL-encode special characters in the password:
#      @ → %40   # → %23   / → %2F   : → %3A   ? → %3F   % → %25
#   5. Check it before starting the backend:  npm run db:check
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/meditrack

# Database name used when MONGODB_URI does not specify one (default: meditrack).
# MONGODB_DB=meditrack

# Secret used to sign JWTs. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long an access token stays valid (default: 15m). Access tokens live only
# in frontend memory; the SPA refreshes them with the httpOnly cookie below.
# JWT_EXPIRES_IN is deprecated and ignored.
JWT_ACCESS_TTL=15m

# How long a refresh session lasts, in days (default: 30). The browser keeps the
# refresh token in a signed, httpOnly cookie; only its hash is stored in MongoDB.
REFRESH_TOKEN_TTL_DAYS=30

# Two tabs can race while rotating the refresh token. Reuse within this window
# (milliseconds) is treated as a race (409 + automatic retry), not theft.
REFRESH_REUSE_GRACE_MS=10000

# Invite-based administrator/staff provisioning.
#
# ADMIN_SIGNUP_CODE is no longer used. Create the first administrator with
# `npm run seed:admin`, then invite further admins/staff from /admin/invites.
# How long an invite stays valid, in hours (default: 72).
# ADMIN_INVITE_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Authentication rate limits (brute-force protection)
# ---------------------------------------------------------------------------
# Window for all auth limits, in milliseconds (default: 15 minutes).
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# Failed sign-in attempts allowed per IP + email inside the window.
# Successful sign-ins are not counted. Default: 10.
# AUTH_LOGIN_RATE_LIMIT_MAX=10

# Account registration requests allowed per IP inside the window.
# Default: 30.
# AUTH_REGISTER_RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Cart / e-commerce
# ---------------------------------------------------------------------------

# Secret used to sign the httpOnly `mt_cart` cookie. Use a different long random
# value from JWT_SECRET, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=change-me-to-another-long-random-string

# Only needed when the frontend is served from a different origin than the API
# (comma separated). The Vite dev proxy makes this unnecessary locally.
# CORS_ORIGIN=https://shop.example.com

# Pricing rules (defaults shown)
TAX_RATE=0.05
DELIVERY_FEE=40
FREE_DELIVERY_OVER=499

# Payment provider: "mock" (sandbox, no keys needed). A real provider can be
# added in backend/lib/providers/ later.
PAYMENT_PROVIDER=mock

# Simulated gateway latency in milliseconds (0 keeps the test suite fast).
PAYMENT_MOCK_DELAY_MS=700

# A pending order reserves stock for this many minutes before it expires.
ORDER_RESERVATION_MINUTES=30
