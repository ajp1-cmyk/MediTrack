# Copy this file to .env and adjust the values.

# Express port
PORT=5000

# ---------------------------------------------------------------------------
# MongoDB connection string — local MongoDB or cloud MongoDB (MongoDB Atlas).
# The application code is identical for both; only this value changes.
#
# Local MongoDB:
#   MONGODB_URI=mongodb://127.0.0.1:27017/meditrack
#
# MongoDB Atlas (cloud):  Atlas → Database → Connect → Drivers → copy the string
#   MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/meditrack?retryWrites=true&w=majority
#
# Atlas checklist:
#   1. Database Access  → create a database user (remember user + password)
#   2. Network Access   → add your IP address (or 0.0.0.0/0 while developing)
#   3. Put the database name in the path (…mongodb.net/meditrack?retryWrites=…).
#      If the path is omitted the app falls back to MONGODB_DB (default
#      "meditrack") instead of writing into MongoDB's default "test" database.
#   4. URL-encode special characters in the password:
#      @ → %40   # → %23   / → %2F   : → %3A   ? → %3F   % → %25
#   5. Check it before starting the backend:  npm run db:check
# ---------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/meditrack

# Database name used when MONGODB_URI does not specify one (default: meditrack).
# MONGODB_DB=meditrack

# Secret used to sign JWTs. Use a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# How long an access token stays valid (default: 15m). Access tokens live only
# in frontend memory; the SPA refreshes them with the httpOnly cookie below.
# JWT_EXPIRES_IN is deprecated and ignored.
JWT_ACCESS_TTL=15m

# How long a refresh session lasts, in days (default: 30). The browser keeps the
# refresh token in a signed, httpOnly cookie; only its hash is stored in MongoDB.
REFRESH_TOKEN_TTL_DAYS=30

# Two tabs can race while rotating the refresh token. Reuse within this window
# (milliseconds) is treated as a race (409 + automatic retry), not theft.
REFRESH_REUSE_GRACE_MS=10000

# ---------------------------------------------------------------------------
# Emailed one-time codes (the "Email code" sign-in on /login).
#
# No keys are needed: with MAIL_PROVIDER=console (the default) the code is
# printed in the server log, which is enough for local development and demos.
#   • POST /api/auth/otp/request emails a 6-digit code
#   • POST /api/auth/otp/verify  checks it and issues the normal MediTrack
#     session (JWT + httpOnly refresh cookie), so roles, carts, orders and
#     prescriptions keep working unchanged
#
# How long a code stays valid, and how many wrong guesses it survives.
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
# Minimum seconds between two codes for the same address.
OTP_RESEND_COOLDOWN_SECONDS=30
#
# OTP_EXPOSE_CODE=true also returns the code in the API reply so it can be typed
# without reading the log. Ignored when NODE_ENV=production — never enable it
# where real users sign in.
# OTP_EXPOSE_CODE=true
#
# Key for the code HMAC (falls back to JWT_SECRET). Rotating it invalidates every
# code that is still in flight.
# OTP_SECRET=
#
# staff/admin accounts stay password-only so a mailbox alone cannot reach stock,
# orders or prescriptions. Set to "true" to allow emailed codes for them too.
# OTP_ALLOW_BACKOFFICE_LOGIN=false
#
# Delivery: "console" (default, no provider) or "resend" (https://resend.com).
# MAIL_PROVIDER=console
# MAIL_FROM=MediTrack <no-reply@your-domain.example>
# RESEND_API_KEY=re_...
# ---------------------------------------------------------------------------

# Invite-based administrator/staff provisioning.
#
# ADMIN_SIGNUP_CODE is no longer used. Create the first administrator with
# `npm run seed:admin`, then invite further admins/staff from /admin/invites.
# How long an invite stays valid, in hours (default: 72).
# ADMIN_INVITE_TTL_HOURS=72

# ---------------------------------------------------------------------------
# Authentication rate limits (brute-force protection)
# ---------------------------------------------------------------------------
# Window for all auth limits, in milliseconds (default: 15 minutes).
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# Failed sign-in attempts allowed per IP + email inside the window.
# Successful sign-ins are not counted. Default: 10.
# AUTH_LOGIN_RATE_LIMIT_MAX=10

# Account registration requests allowed per IP inside the window.
# Default: 30.
# AUTH_REGISTER_RATE_LIMIT_MAX=30

# ---------------------------------------------------------------------------
# Cart / e-commerce
# ---------------------------------------------------------------------------

# Secret used to sign the httpOnly `mt_cart` cookie. Use a different long random
# value from JWT_SECRET, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
COOKIE_SECRET=change-me-to-another-long-random-string

# ---------------------------------------------------------------------------
# Browser origins allowed to call the API (comma separated).
#
# Same-origin deployments do NOT need an entry: the server accepts an `Origin`
# whose host matches the request's `X-Forwarded-Host`/`Host`, which covers the
# built SPA served by the API or the Netlify SPA + Netlify Function setup.
#
# Add entries only when the browser loads the SPA from a different origin than
# the API (a custom frontend host, a split Netlify/Render deploy, or a custom
# domain that calls the API directly):
#   CORS_ORIGIN=https://shop.example.com,https://branch--site.netlify.app
#
# Browsers attach `Origin` to every POST/PATCH/DELETE, so an unlisted split
# origin gets 403 on sign-in, cart and checkout while GETs still work. The
# cart/refresh cookies are SameSite=Lax, so a truly cross-site frontend needs
# more than a CORS entry.
#
# The Vite dev proxy makes this unnecessary locally.
# CORS_ORIGIN=https://shop.example.com

# Pricing rules (defaults shown)
TAX_RATE=0.05
DELIVERY_FEE=40
FREE_DELIVERY_OVER=499

# Payment provider: "mock" (sandbox, no keys needed). A real provider can be
# added in backend/lib/providers/ later.
PAYMENT_PROVIDER=mock

# Simulated gateway latency in milliseconds (0 keeps the test suite fast).
PAYMENT_MOCK_DELAY_MS=700

# A pending order reserves stock for this many minutes before it expires.
ORDER_RESERVATION_MINUTES=30

# ---------------------------------------------------------------------------
# Inventory replenishment (SRS FR-1.1)
# ---------------------------------------------------------------------------
# A medicine whose stock reaches LOW_STOCK_WATERMARK is refilled back up to
# REPLENISH_TO units by the background sweep (and by
# POST /api/admin/inventory/replenish). Expired medicines are never refilled.
LOW_STOCK_WATERMARK=10
REPLENISH_TO=100

# How often the sweep looks for low stock, in milliseconds (default: 1 minute).
REPLENISH_INTERVAL_MS=60000

# Set to "off" to disable the background sweep. The admin endpoint still works.
INVENTORY_AUTO_REPLENISH=on

# ---------------------------------------------------------------------------
# Cart soft holds (SRS FR-1.2 / FR-1.3)
# ---------------------------------------------------------------------------
# Adding a medicine to the cart moves it out of `stock` and into `held` for this
# many minutes. When the hold lapses the units go back to `stock` and the cart
# line stays put, flagged "hold expired" so the customer can refresh it.
CART_HOLD_MINUTES=15

# How often the background sweep releases lapsed holds, in milliseconds
# (default: 1 minute). A cart read also releases its own lapsed holds lazily.
CART_HOLD_SWEEP_INTERVAL_MS=60000

# ---------------------------------------------------------------------------
# MediPoints (SRS FR-2.4)
# ---------------------------------------------------------------------------
# Points credited per whole ₹100 of an order total, after payment succeeds.
# 0 disables earning.
MEDIPOINTS_PER_100=1

# ---------------------------------------------------------------------------
# Prescription uploads (SRS FR-1.4 / FR-2.1, NFR-1.4)
# ---------------------------------------------------------------------------
# Uploaded scans are encrypted with AES-256-GCM before they are written to
# MongoDB (never to the public uploads/ directory). Generate a dedicated key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Set it in production. When it is missing, a key is derived from JWT_SECRET —
# rotations of JWT_SECRET then make existing prescriptions unreadable.
# RX_ENCRYPTION_KEY=change-me-to-64-hex-characters

# How long an approved prescription stays valid, in days (default 365).
PRESCRIPTION_VALID_DAYS=365

# ---------------------------------------------------------------------------
# Fair-use daily purchase cap (SRS FR-1.4, NFR-2.2)
# ---------------------------------------------------------------------------
# Maximum units one customer may order per UTC calendar day, across all orders.
# Checked when the order is created (before stock moves); cancelled and expired
# orders do not count. 0 disables the cap. An invalid value falls back to 10.
DAILY_PURCHASE_LIMIT=10
